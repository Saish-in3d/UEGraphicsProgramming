#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

struct FGPUParticle
{
	float3 Position;

	float Life;

	float3 Velocity;
};

struct FVSOut
{
	float4 Position : SV_POSITION;
	float  Life     : TEXCOORD0;
};
 
StructuredBuffer<FGPUParticle> FS3L1_ParticleBuffer;
float4x4 WorldToClip;
float    PointSize;     
uint     ParticleCount;

void FS3L1_BasicParticleEffectVS(uint VertexId : SV_VertexID, out FVSOut Out)
{
	
	uint particleIndex = VertexId / 6;
	uint corner        = VertexId % 6;

	FGPUParticle P = FS3L1_ParticleBuffer[particleIndex];

	float4 clip = mul(float4(P.Position, 1.0), WorldToClip);

	// unit quad corners
	float2 offsets[6] =
	{
		float2(-1,-1), float2(1,-1), float2(-1,1),
		float2(-1, 1), float2(1,-1), float2(1, 1)
	};
	float2 o = offsets[corner] * PointSize * clip.w;

	clip.xy += o;
	Out.Position = clip;
	Out.Life     = P.Life;
	
}


void FS3L1_BasicParticleEffectPS(FVSOut In, out float4 OutColor : SV_Target0)
{
	//float a = saturate(In.Life / 6.0);
	OutColor = float4(1,0,0,0)/*float4(a, 0.4 * a, 1.0 - a, 1.0)*/;
}