#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"


shared RWTexture2D<float4> FS2L1_Output;
int CircleRadius;
int Centre;
float Deltatime;




void plotsinglepoint(int X, int y, uint2 centre)
{

	FS2L1_Output[uint2(centre.x + X, centre.y+ y)] = float4(int(0.f),int(0.f),int(1.f),int(1.f));
}


void ploteightpoints(int x, int y, uint2 centre)
{
	plotsinglepoint(  x,  y, centre );  plotsinglepoint(  y,  x, centre );
	plotsinglepoint(  x, -y, centre );  plotsinglepoint(  y, -x, centre );
	plotsinglepoint( -x, -y, centre );  plotsinglepoint( -y, -x, centre );
	plotsinglepoint( -x,  y, centre );  plotsinglepoint( -y,  x, centre );
}

//Using Bresenham's algorithm to draw circle
void drawCircle( uint2 centre, int radius){
	int x = 0;
	int y = radius;
	int d = 1 - radius;

	while (x < y)
	{
		if (d < 0){
			d += 2 * x + 3;
		}else{
			d += 2 * (x - y) + 5;
			y--;
		}
		
		ploteightpoints(x, y, centre);

		x++;
	}
}

/*Returns pseudo random number in range 0 <= x < 1 */
//Returns random value from 0-1
float random(float value, float seed = 0.546){
	float random = (frac(sin(value + seed) * 143758.5453));// + 1.0)/2.0;
	return random;
}

//Returns random value from 0-1
float2 random2(float value){
	return float2(
		random(value, 3.9812),
		random(value, 7.1536)
	);
}


[numthreads(THREADS_X,THREADS_Y,THREADS_Z)]
void FS2L1_SingleThreadRingCS(uint2 DispatchThreadId : SV_DispatchThreadID)
{
	//Thread marked as black to see if we are running on single thread
	FS2L1_Output[DispatchThreadId.xy] = float4(int(0.f),int(0.f),int(0.f),int(1.f));
	
	//Changing to random centre and radius, check previous commit to see simple implementation
	uint2 RandCentre = (uint2)(random2((float)DispatchThreadId.x + Deltatime )*256);
	int RandRadius = (int)(random(((float)DispatchThreadId.x))*30); 
	
	drawCircle(RandCentre,RandRadius);
	//drawCircle(Centre,CircleRadius);
}