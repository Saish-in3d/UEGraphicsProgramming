#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"


shared RWTexture2D<float4> FS1L2_Output;


[numthreads(THREADS_X,THREADS_Y,THREADS_Z)]
void FS1L2_ClearColorCS(uint2 DispatchThreadId : SV_DispatchThreadID)
{
	
	//Drawing solid red color
	FS1L2_Output[DispatchThreadId.xy] = float4(1,0,0,1);
}