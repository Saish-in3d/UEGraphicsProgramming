#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

shared RWTexture2D<float4> FS2L4_Output;
float Deltatime;


float random (float2 pt, float seed) {
	const float a = 12.9898;
	const float b = 78.233;
	const float c = 43758.543123;
	return frac(sin(dot(pt, float2(a, b)) + seed) * c );
}


[numthreads(THREADS_X,THREADS_Y,THREADS_Z)]
void FS2L4_BasicNoiseCS(uint2 DispatchThreadId : SV_DispatchThreadID)
{
	float4 white = 1;
	
	
	//Drawing solid red color
	FS2L4_Output[DispatchThreadId.xy] = random(((float2)id.xy)/(float)texResolution, Deltatime) * white;
}